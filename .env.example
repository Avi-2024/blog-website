# Production: use https://toolvaluelab.com for both site URL and admin origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STAGING_NOINDEX=true
# Production PostgreSQL connection. Leave blank for local embedded development DB.
DATABASE_URL=
CMS_ADMIN_ORIGIN=http://localhost:3000
CRON_SECRET=
# Preferred: Cloudinary free plan for CMS images. Set all three server-side.\nCLOUDINARY_CLOUD_NAME=\nCLOUDINARY_API_KEY=\nCLOUDINARY_API_SECRET=\n# Optional alternative: S3-compatible storage (leave blank if using Cloudinary).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
CMS_DATA_DIR=
CMS_MEDIA_DIR=
CMS_LOCAL_MODE=false
CONTACT_ENDPOINT_URL=
CONTACT_ENDPOINT_TOKEN=
NEWSLETTER_ENDPOINT_URL=
NEWSLETTER_ENDPOINT_TOKEN=
REDIS_REST_URL=
REDIS_REST_TOKEN=
FORM_ALLOWED_ORIGINS=

# Set to the official pub-XXXXXXXXXXXXXXXX AdSense ID after account setup.
# ads.txt is intentionally unavailable until this is set; no ads are loaded automatically.
ADSENSE_PUBLISHER_ID=
